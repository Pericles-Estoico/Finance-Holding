# Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key   # Só no servidor — nunca expor no frontend

# Google Cloud Vision (OCR de notas fiscais)
GOOGLE_VISION_API_KEY=

# Google Drive (importacao automatica de comprovantes)
# IMPORTANTE: variaveis VITE_* sao embutidas no bundle pelo Vite no momento do build.
# No Vercel, adicione-as em Settings > Environment Variables e acione um novo deploy.
VITE_GOOGLE_DRIVE_CLIENT_ID=     # OAuth 2.0 Client ID (tipo "Aplicativo da Web")
VITE_GOOGLE_DRIVE_API_KEY=       # Chave de API (restrita a Drive API + Picker API)

# Anthropic (Claude AI — para WhatsApp e outros usos)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=EAAxxxxxxxx              # Token de acesso permanente do App
WHATSAPP_PHONE_ID=1234567890123         # Phone Number ID (no painel Meta)
WHATSAPP_VERIFY_TOKEN=finance_master_verify  # Token de verificação do webhook (você escolhe)
WHATSAPP_ALLOWED_NUMBERS=5511999999999,5521888888888  # Números autorizados (sem + nem espaço)

# === AIOX Variables (added 2026-05-31) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.2.8

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: ANTHROPIC_API_KEY=
# AIOX_SUGGESTED: SUPABASE_SERVICE_ROLE_KEY=
